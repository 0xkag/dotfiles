#!/usr/bin/env bash

# What the terminal (and tmux, if inside it) can do: identity, truecolor,
# the features tmux detected for this client (sixel, RGB, clipboard, ...),
# the image format mc and vifm draw with (image-view -q), and with --image, a
# test picture in that format to show what actually gets through.  See
# _docs/terminal-images.org.
#
#   term-features            report
#   term-features --image    report, then draw a test gradient
#   term-features FILE       report, then draw FILE

set -u

row () {
    printf "%-22s %s\n" "$1" "${2:-(unset)}"
}

row TERM "${TERM:-}"
row TERM_PROGRAM "${TERM_PROGRAM:-}"
row COLORTERM "${COLORTERM:-}"
[ -n "${WT_SESSION:-}" ] && row WT_SESSION "$WT_SESSION (Windows Terminal)"

if [ -n "${TMUX:-}" ]; then
    # tmux detects features per client from the outer terminal's replies
    # (sixel from primary device attributes, others from XTVERSION and
    # terminal-features); a feature missing here never reaches programs.
    row "tmux version" "$(tmux display -p '#{version}')"
    row "tmux client TERM" "$(tmux display -p '#{client_termname}')"
    row "tmux client type" "$(tmux display -p '#{client_termtype}')"
    features=$(tmux display -p '#{client_termfeatures}')
    row "tmux client features" "$features"
    # tmux lists sixel for a client whose terminal reported it however tmux
    # was built, so whether tmux can draw it is a separate question:
    # #{sixel_support} answers it from tmux 3.6, and image-view below asks
    # older tmux directly
    case ",$features," in
        *,sixel,*) row "tmux client sixel" "yes: the terminal reported sixel" ;;
        *) row "tmux client sixel" "no: the terminal did not report sixel" ;;
    esac
    row "tmux sixel_support" "$(tmux display -p '#{sixel_support}') (1: tmux draws sixel; empty before tmux 3.6)"
    row "tmux passthrough" "$(tmux show -gv allow-passthrough 2>/dev/null) (kitty/iTerm2 images need on)"
else
    row tmux "(not inside tmux)"
fi
row "image-view format" "$(image-view -q) (mc's and vifm's full-screen view)"

image="${1:-}"
[ -z "$image" ] && exit 0

if ! command -v chafa > /dev/null; then
    echo "chafa not installed; see _docs/terminal-images.org" >&2
    exit 1
fi

tmp=""
if [ "$image" = "--image" ]; then
    # ImageMagick 7's magick, or 6's convert (e.g., Ubuntu's package)
    if ! magick=$(command -v magick || command -v convert); then
        echo "--image needs ImageMagick; pass an image file instead" >&2
        exit 1
    fi
    tmp=$(mktemp --suffix=.png)
    trap 'rm -f "$tmp"' EXIT
    "$magick" -size 320x120 gradient:'#dc322f'-'#3799de' "$tmp"
    image=$tmp
fi

echo
# Draw in the format image-view -q reported rather than chafa's own choice,
# which inside tmux only sees tmux; force one with: chafa -f sixels FILE
image-view -i 40x8 "$image"
