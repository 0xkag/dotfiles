def heading(s):
    print('\033[31m[*] %s\033[0m' % s)

def step(s):
    print('\033[33m[+] %s\033[0m' % s)

def relink(target, linkname):
    target = os.path.expanduser(target)
    linkname = os.path.expanduser(linkname)
    if os.path.lexists(linkname):
        if os.path.islink(linkname):
            os.unlink(linkname)
        else:
            raise Exception('%s is not a symlink' % linkname)
    os.symlink(target, linkname)

def relink_relative(target, linkname):
    target = os.path.expanduser(target)
    linkname = os.path.expanduser(linkname)
    if os.path.lexists(linkname):
        if os.path.islink(linkname):
            os.unlink(linkname)
        else:
            raise Exception('%s is not a symlink' % linkname)
    os.symlink(os.path.relpath(target, os.path.dirname(linkname)), linkname)

def unlink(p):
    try:
        os.unlink(os.path.expanduser(p))
    except:
        pass

def mkdir(p):
    try:
        os.makedirs(os.path.expanduser(p))
    except:
        pass

def run(p):
    try:
        parts = shlex.split(p)
        parts = [os.path.expanduser(part) for part in parts]
        env = os.environ.copy()
        env['PYTHONNOCLEANSYSPATH'] = '1'
        subprocess.check_call(' '.join(parts), shell=True, env=env)
    except:
        raise

# This host's system as flox names it: x86_64-linux, aarch64-linux,
# aarch64-darwin, x86_64-darwin (anything else is a system flox lacks).
def flox_system():
    machine = platform.machine().replace('arm64', 'aarch64')
    return '%s-%s' % (machine, platform.system().lower())

# The systems flox/.flox's manifest lists in [options] systems; without that
# list flox resolves for its default systems plus the current one, so this
# host's system always qualifies.
# ponytail: regex, not a TOML parser; the python3 running this may predate
# tomllib (3.11)
def flox_systems():
    p = os.path.expanduser('~/.dotfiles/flox/.flox/env/manifest.toml')
    with open(p) as f:
        match = re.search(r'^systems\s*=\s*\[(.*?)\]', f.read(),
                          re.MULTILINE | re.DOTALL)
    if match is None:
        return [flox_system()]
    return re.findall(r'"([^"]+)"', match.group(1))

# The directory of mc's stock extension handlers, as `mc -F` reports it, but
# reached through the prefix of the mc on PATH when that holds it too, so that
# a profile's path (e.g., ~/.flox/run/...) survives upgrades that move the
# real one; None without mc.
def mc_ext_d():
    mc = shutil.which('mc')
    if mc is None:
        return None
    info = subprocess.run([mc, '-F'], capture_output=True, text=True).stdout
    match = re.search(r'^\s*File extension handlers:\s*(.+?)/?\s*$', info,
                      re.MULTILINE)
    if match is None:
        return None

    ext_d = match.group(1)
    real_prefix = os.path.dirname(os.path.dirname(os.path.realpath(mc)))
    if ext_d.startswith(real_prefix + '/'):
        prefix = os.path.dirname(os.path.dirname(mc))
        profile_ext_d = prefix + ext_d[len(real_prefix):]
        if os.path.isdir(profile_ext_d):
            return profile_ext_d
    return ext_d

