#!/bin/bash

input=$(cat)
cwd=$(echo "$input" | jq -r '.workspace.current_dir')
user=$(whoami)
host=$(hostname -s)
git_info=$(cd "$cwd" 2>/dev/null && git rev-parse --abbrev-ref HEAD 2>/dev/null | sed 's/.*/git:(\0)/')

# Session telemetry (model, effort, thinking, cost, tokens, context %) pulled
# from the statusline JSON in a single jq pass.  Fields absent on older Claude
# Code versions render as empty/zero and their segments are skipped.
IFS='|' read -r model effort thinking cost used max pct wt < <(echo "$input" | jq -r '
    [(.model.display_name // .model.id // ""),
     (.effort.level // ""),
     (if .thinking.enabled then "on" else "" end),
     (.cost.total_cost_usd // 0),
     ((.context_window.current_usage // {})
        | (.input_tokens // 0) + (.output_tokens // 0)
          + (.cache_read_input_tokens // 0) + (.cache_creation_input_tokens // 0)),
     (.context_window.context_window_size // 0),
     (.context_window.used_percentage // 0),
     (.worktree.name // "")]
    | map(tostring) | join("|")')

# Segments self-hide when their field is absent, so each carries its own
# label rather than relying on position.
telemetry=''
[ -n "$wt" ] && telemetry+=" wt=[${wt}]"
[ -n "$model" ] && telemetry+=" m=[${model}]"
[ -n "$effort" ] && telemetry+=" e=[${effort}]"
[ -n "$thinking" ] && telemetry+=' [thinking]'
[ -n "$cost" ] && [ "$cost" != 0 ] && telemetry+=$(printf ' [$%.2f]' "$cost")

ctx=''
[ -n "$max" ] && [ "$max" != 0 ] && [ "$used" != 0 ] \
    && ctx="$((used / 1000))k/$((max / 1000))k"
if [ -n "$pct" ] && [ "$pct" != 0 ]; then
    pct_int=$(printf '%.0f' "$pct")
    if [ "$pct_int" -ge 90 ]; then
        pct_disp=$(printf '\033[1;31m%d%%\033[0;2m' "$pct_int")
    elif [ "$pct_int" -ge 70 ]; then
        pct_disp=$(printf '\033[1;33m%d%%\033[0;2m' "$pct_int")
    else
        pct_disp="${pct_int}%"
    fi
    ctx="${ctx:+$ctx }${pct_disp}"
fi
[ -n "$ctx" ] && telemetry+=" ctx=[${ctx}]"

# Credential-expired warning, prepended only when the sandbox refresh loop has
# written the sentinel.  Harmless outside the sandbox where the file is absent.
cred_warn=''
if [ -f "${HOME}/.aws/CREDENTIAL_EXPIRED" ]; then
    cred_warn=$'\033[1;31mCREDS EXPIRED: kinit + run --push-creds\033[0m '
fi

printf "%s\033[1;32m%s@%s:\033[0;36m%s\033[1;34m%s\033[0m\033[2m%s\033[0m" \
    "$cred_warn" "$user" "$host" "$cwd" "${git_info:+ $git_info}" "$telemetry"
